{
  "name": "node-jt400",
  "version": "8.0.0",
  "description": "JT400 (IBM Toolbox) for NodeJS",
  "keywords": [
    "typescript",
    "javascript",
    "as400",
    "IBM",
    "java",
    "db2",
    "jdbc",
    "jt400"
  ],
  "bugs": {
    "url": "https://github.com/tryggingamidstodin/node-jt400/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/tryggingamidstodin/node-jt400.git"
  },
  "license": "MIT",
  "author": "Tryggingamiðstöðin <bt.hugbunadargerd@tm.is>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-esm/index.d.ts",
        "default": "./dist-esm/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    }
  },
  "main": "dist-cjs/index.js",
  "module": "dist-esm/index.js",
  "types": "dist-esm/index.d.ts",
  "files": [
    "dist-esm",
    "dist-cjs",
    "java/lib"
  ],
  "scripts": {
    "build": "tsdown",
    "build-all": "npm run build && npm run build-java",
    "build-dev": "tsdown --watch",
    "build-java": "ant archive -buildfile ./java",
    "ci": "npm run clean && npm run build && npm run test && npm run test-cjs && npm run integration-test && npm run integration-cjs-test && npm run test-compatibility",
    "clean": "rm -rf dist-esm dist-cjs",
    "format": "prettier --write ./ts-src/**/*.ts",
    "format-verify": "prettier --check ./ts-src/**/*.ts",
    "integration-cjs-test": "node --enable-source-maps --test --test-force-exit --test-timeout=10000 --test-concurrency=1 \"dist-cjs/integration-test/**/*-spec.js\"",
    "integration-test": "node --enable-source-maps --test --test-force-exit --test-timeout=10000 --test-concurrency=1 \"dist-esm/integration-test/**/*-spec.js\"",
    "lint": "eslint ts-src/**/*.ts",
    "test": "node --enable-source-maps --test --test-force-exit --test-timeout=1000 \"dist-esm/unit-test/**/*-spec.js\"",
    "test-cjs": "node --enable-source-maps --test --test-force-exit --test-timeout=1000 \"dist-cjs/unit-test/**/*-spec.js\"",
    "test-compatibility": "node test-mjs.mjs && node test-cjs.cjs && cd /tmp && node $INIT_CWD/test-mjs.mjs && node $INIT_CWD/test-cjs.cjs && node $INIT_CWD/test-consumers.mjs",
    "test-dev": "node --test --watch \"dist-esm/unit-test/**/*-spec.js\""
  },
  "dependencies": {
    "java": "^0.19.0",
    "oops-error": "^2.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "~6.0",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  },
  "engines": {
    "node": ">=22"
  }
}
