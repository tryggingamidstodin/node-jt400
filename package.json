{
  "name": "node-jt400",
  "version": "7.0.2",
  "description": "JT400 (IBM Toolbox) for NodeJS",
  "keywords": [
    "typescript",
    "javascript",
    "as400",
    "IBM",
    "java",
    "db2",
    "jdbc",
    "jt400"
  ],
  "bugs": {
    "url": "https://github.com/tryggingamidstodin/node-jt400/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/tryggingamidstodin/node-jt400.git"
  },
  "license": "MIT",
  "author": "Tryggingamiðstöðin <bt.hugbunadargerd@tm.is>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-esm/index.d.ts",
        "default": "./dist-esm/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    }
  },
  "main": "dist-cjs/index.js",
  "module": "dist-esm/index.js",
  "types": "dist-esm/index.d.ts",
  "files": [
    "dist-esm",
    "dist-cjs",
    "java/lib"
  ],
  "scripts": {
    "build": "tsdown",
    "build-all": "npm run build && npm run build-java",
    "build-dev": "tsdown --watch",
    "build-java": "ant archive -buildfile ./java",
    "ci": "npm run clean && npm run build && npm run test && npm run test-cjs && npm run integration-test && npm run integration-cjs-test && npm run test-compatibility",
    "clean": "rm -rf dist-esm dist-cjs",
    "format": "prettier --write ./ts-src/**/*.ts",
    "format-verify": "prettier --check ./ts-src/**/*.ts",
    "integration-cjs-test": "node --enable-source-maps --test --test-concurrency=1 --test-force-exit --test-timeout=10000 dist-cjs/integration-test/*-spec.js",
    "integration-test": "node --enable-source-maps --test --test-concurrency=1 --test-force-exit --test-timeout=10000 dist-esm/integration-test/*-spec.js",
    "lint": "eslint ts-src/**/*.ts",
    "test": "node --enable-source-maps --test --test-concurrency=1 --test-force-exit --test-timeout=1000 dist-esm/unit-test/*-spec.js",
    "test-cjs": "node --enable-source-maps --test --test-concurrency=1 --test-force-exit --test-timeout=1000 dist-cjs/unit-test/*-spec.js",
    "test-compatibility": "node test-mjs.mjs && node test-cjs.cjs && cd /tmp && node $INIT_CWD/test-mjs.mjs && node $INIT_CWD/test-cjs.cjs && node $INIT_CWD/test-consumers.mjs",
    "test-dev": "node --enable-source-maps --test --watch --test-concurrency=1 --test-force-exit --test-timeout=1000 dist-esm/unit-test/*-spec.js"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm run format-verify",
      "pre-push": "npm run build && npm run test"
    }
  },
  "overrides": {
    "brace-expansion@5": "5.0.12"
  },
  "dependencies": {
    "java": "^0.18.0",
    "oops-error": "^2.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22"
  }
}
