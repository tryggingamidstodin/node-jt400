{
  "name": "node-jt400",
  "version": "7.0.1",
  "description": "JT400 (IBM Toolbox) for NodeJS",
  "keywords": [
    "typescript",
    "javascript",
    "as400",
    "IBM",
    "java",
    "db2",
    "jdbc",
    "jt400"
  ],
  "bugs": {
    "url": "https://github.com/tryggingamidstodin/node-jt400/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/tryggingamidstodin/node-jt400.git"
  },
  "license": "MIT",
  "author": "Tryggingamiðstöðin <bt.hugbunadargerd@tm.is>",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist-esm/index.d.ts",
        "default": "./dist-esm/index.js"
      },
      "require": {
        "types": "./dist-cjs/index.d.ts",
        "default": "./dist-cjs/index.js"
      }
    }
  },
  "main": "dist-cjs/index.js",
  "module": "dist-esm/index.js",
  "types": "dist-esm/index.d.ts",
  "files": [
    "dist-esm",
    "dist-cjs",
    "java/lib"
  ],
  "scripts": {
    "build": "tsdown",
    "build-all": "npm run build && npm run build-java",
    "build-dev": "tsdown --watch",
    "build-java": "ant archive -buildfile ./java",
    "ci": "npm run clean && npm run build && npm run test && npm run test-cjs && npm run integration-test && npm run integration-cjs-test && npm run test-compatibility",
    "clean": "rm -rf dist-esm dist-cjs",
    "format": "prettier --write ./ts-src/**/*.ts",
    "format-verify": "prettier --check ./ts-src/**/*.ts",
    "integration-cjs-test": "mocha -r source-map-support/register --exit dist-cjs/integration-test -t 10000",
    "integration-test": "mocha -r source-map-support/register --exit dist-esm/integration-test -t 10000",
    "lint": "eslint ts-src/**/*.ts",
    "test": "mocha -r source-map-support/register --exit dist-esm/unit-test -t 1000",
    "test-cjs": "mocha -r source-map-support/register --exit dist-cjs/unit-test -t 1000",
    "test-compatibility": "node test-mjs.mjs && node test-cjs.cjs && cd /tmp && node $INIT_CWD/test-mjs.mjs && node $INIT_CWD/test-cjs.cjs && node $INIT_CWD/test-consumers.mjs",
    "test-dev": "mocha dist-esm/unit-test --watch"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint && npm run format-verify",
      "pre-push": "npm run build && npm run test"
    }
  },
  "overrides": {
    "mocha": {
      "diff": "8.0.4",
      "serialize-javascript": "7.1.0"
    }
  },
  "dependencies": {
    "flushwritable": "^1.0.0",
    "java": "^0.18.0",
    "JSONStream": "^1.3.5",
    "oops-error": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.5",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "mocha": "^11.8.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "stream-equal": "^2.0.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22"
  }
}
